<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      调试工具的编译期开关
    -->
    <DefineConstants Condition="'$(EliteDebug)' == 'true'">$(DefineConstants);ELITE_DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>EliteEnemies</AssemblyName>
    <RootNamespace>EliteEnemies</RootNamespace>

    <!--
      版本号的**唯一来源**。
      info.ini 的 version 由构建期从 workshop\info.ini.template 的 @VERSION@ 生成，
      发版时只改这一行，然后 dotnet build 即可。
    -->
    <Version>2.3.2</Version>

    <Product>Elite Enemies</Product>
    <Company>LOVEIII486</Company>
    <Copyright>Copyright © 2025 LOVEIII486</Copyright>
    <Description>精英怪模组 for Escape From Duckov</Description>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup Label="包">
    <!-- Harmony 2.4.1 net472 - 与工坊前置模组逐字节相同。
         GeneratePathProperty: NuGet 不会复制 DLL 到 bin\，需从包内显式取。
         详见 docs/build-system.md §1 -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1">
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>

    <!-- Publicizer - 编译期公开游戏程序集的私有成员，避免运行时反射。
         详见 docs/build-system.md §2 -->
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Publicizer">
    <!-- Include 匹配程序集文件名（不含扩展名），不是命名空间。
         IncludeVirtualMembers=false: 避免干扰 Harmony 补丁匹配。
         IncludeCompilerGeneratedMembers=false: 编译器生成成员不是稳定契约。
         详见 docs/build-system.md §2.3 -->
    <Publicize Include="TeamSoda.Duckov.Core"
               IncludeVirtualMembers="false"
               IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="TeamSoda.Duckov.Utilities"
               IncludeVirtualMembers="false"
               IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="ItemStatsSystem"
               IncludeVirtualMembers="false"
               IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="TeamSoda.MiniLocalizor"
               IncludeVirtualMembers="false"
               IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <!-- 游戏程序集 - 注意命名空间与程序集名不同名的情况：
       SodaCraft.Localizations -> SodaLocalization.dll
       NodeCanvas.Framework -> NodeCanvas.dll
       TMPro -> Unity.TextMeshPro.dll
       UnityEngine.AI -> UnityEngine.AIModule.dll
       UnityEngine.InputSystem -> Unity.InputSystem.dll -->
  <ItemGroup Label="游戏程序集">
    <Reference Include="Assembly-CSharp;TeamSoda.Duckov.Core;TeamSoda.Duckov.Utilities;TeamSoda.MiniLocalizor;SodaLocalization;ItemStatsSystem;NodeCanvas;ParadoxNotion;ECM2">
      <HintPath>$(DuckovManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule;UnityEngine.AIModule;UnityEngine.UIModule;UnityEngine.IMGUIModule;UnityEngine.InputLegacyModule;UnityEngine.UI;UnityEngine.PhysicsModule;UnityEngine.AudioModule;UnityEngine.AnimationModule;UnityEngine.ParticleSystemModule;UnityEngine.TextRenderingModule;Unity.TextMeshPro;Unity.InputSystem">
      <HintPath>$(DuckovManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 传递依赖 - 本模组代码不直接用，但游戏类型的公开签名里出现了它们的类型（CS0012） -->
    <Reference Include="FMODUnity;Sirenix.OdinInspector.Attributes;UniTask;Newtonsoft.Json;DOTween">
      <HintPath>$(DuckovManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- info.ini 生成配置 -->
  <PropertyGroup>
    <_InfoIniTemplate>$(MSBuildProjectDirectory)\workshop\info.ini.template</_InfoIniTemplate>
    <!-- 用 BaseIntermediateOutputPath（obj\）而非 IntermediateOutputPath，
         后者在项目级属性求值阶段还是空的。-->
    <_GeneratedInfoIni>$(BaseIntermediateOutputPath)info.ini</_GeneratedInfoIni>
  </PropertyGroup>

  <!-- 构建提示格式 - 详见 docs/build-system.md §5 -->
  <PropertyGroup>
    <_EliteTag>[EliteEnemies]</_EliteTag>
    <_EliteDebugState Condition="'$(EliteDebug)' == 'true'">调试工具开</_EliteDebugState>
    <_EliteDebugState Condition="'$(EliteDebug)' != 'true'">调试工具关</_EliteDebugState>
    <_EliteBuildMark>$(Configuration) · $(_EliteDebugState)</_EliteBuildMark>
  </PropertyGroup>

  <!-- GenerateModInfo: 从模板生成 info.ini，替换版本号占位符。
       挂 BeforeBuild 而非 Build: 确保 DeployToGame 能取到生成物。
       不用 Inputs/Outputs: 版本号变化不会让模板时间戳更新。
       详见 docs/build-system.md §3.1 -->
  <Target Name="GenerateModInfo" BeforeTargets="BeforeBuild">

    <Error Condition="!Exists('$(_InfoIniTemplate)')"
           Text="缺少 workshop\info.ini.template。info.ini 现在由它生成，模板本身必须存在。" />

    <PropertyGroup>
      <_TemplateText>$([System.IO.File]::ReadAllText('$(_InfoIniTemplate)'))</_TemplateText>
      <_TemplateText>$([System.Text.RegularExpressions.Regex]::Replace($(_TemplateText), '(?m)^\s*;.*\r?\n', ''))</_TemplateText>
      <_TemplateText>$(_TemplateText.Replace('@VERSION@', '$(Version)'))</_TemplateText>

      <_IniName>$([System.Text.RegularExpressions.Regex]::Match($(_TemplateText), '(?m)^\s*name\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</_IniName>
      <_IniDisplayName>$([System.Text.RegularExpressions.Regex]::Match($(_TemplateText), '(?m)^\s*displayName\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</_IniDisplayName>
      <_IniDescription>$([System.Text.RegularExpressions.Regex]::Match($(_TemplateText), '(?m)^\s*description\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</_IniDescription>
      <_IniVersion>$([System.Text.RegularExpressions.Regex]::Match($(_TemplateText), '(?m)^\s*version\s*=\s*([^\r\n]+)').Groups[1].Value.Trim())</_IniVersion>
    </PropertyGroup>

    <Error Condition="'$(_IniName)' == ''"
           Text="info.ini.template 缺少 name 键（或该行为空）。没有 name，ModManager.TryProcessModFolder 直接返回 false（ModManager.cs:304），模组不会出现在游戏列表里。" />
    <Error Condition="'$(_IniDisplayName)' == ''"
           Text="info.ini.template 缺少 displayName 键（或该行为空）。" />
    <Error Condition="'$(_IniDescription)' == ''"
           Text="info.ini.template 缺少 description 键（或该行为空）。" />

    <Error Condition="'$(_IniVersion)' != '$(Version)'"
           Text="生成出的 info.ini 版本号为 '$(_IniVersion)'，与 csproj 的 &lt;Version&gt; '$(Version)' 不符。请检查模板里是否残留了硬编码的版本号（应写 @VERSION@）。" />

    <Error Condition="'$(_IniName)' != '$(AssemblyName)'"
           Text="info.ini.template 的 name = '$(_IniName)' 与程序集名 '$(AssemblyName)' 不一致。二者必须相同，否则模组加载失败。" />

    <Warning Condition="'$(_IniName)' != '$(RootNamespace)'"
             Text="RootNamespace = '$(RootNamespace)' 与 info.ini 的 name = '$(_IniName)' 不一致。游戏不要求二者相等，但本项目约定 name / AssemblyName / RootNamespace 取同一值，以免改动时漏同步。" />

    <WriteLinesToFile File="$(_GeneratedInfoIni)" Lines="$(_TemplateText)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <Message Importance="high" Text="$(_EliteTag) info.ini · 已生成（version = $(Version)）· $(_EliteBuildMark)" />
  </Target>

  <!-- DeployToGame: 构建后同步产物到游戏 Mods 目录。
       -p:DeployToGame=false 关闭；游戏目录不存在时自动跳过。
       详见 docs/build-system.md §3.2 -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(DeployToGame)' != 'false' and Exists('$(DuckovGameDir)')">
    <PropertyGroup>
      <_ModDir>$(DuckovModsDir)\EliteEnemies</_ModDir>
      <_ModLocDir>$(_ModDir)\Localization</_ModLocDir>
      <!-- 0Harmony.dll 部署到 libs\ 子目录 - 让常规解析失败，由 HarmonyResolver 介入。
           详见 docs/build-system.md §1.3 -->
      <_ModLibDir>$(_ModDir)\libs</_ModLibDir>
      <_HarmonyDll>$(PkgLib_Harmony)\lib\net472\0Harmony.dll</_HarmonyDll>
    </PropertyGroup>

    <MakeDir Directories="$(_ModDir);$(_ModLocDir);$(_ModLibDir)" />

    <ItemGroup>
      <_Deploy Include="$(TargetPath)" />
      <_Deploy Include="$(_GeneratedInfoIni)" Condition="Exists('$(_GeneratedInfoIni)')" />
      <_Deploy Include="$(MSBuildProjectDirectory)\workshop\preview.png" Condition="Exists('$(MSBuildProjectDirectory)\workshop\preview.png')" />
      <!-- 译者指南与 CSV 并排部署到 Localization\ 子目录 -->
      <_DeployCsv Include="$(MSBuildProjectDirectory)\workshop\LocalizationGuide.md"
                  Condition="Exists('$(MSBuildProjectDirectory)\workshop\LocalizationGuide.md')" />
      <_DeployCsv Include="$(MSBuildProjectDirectory)\localization\*.csv" />
      <_DeployLib Include="$(_HarmonyDll)" Condition="Exists('$(_HarmonyDll)')" />
    </ItemGroup>

    <Error Condition="!Exists('$(_HarmonyDll)')"
           Text="找不到 0Harmony.dll：'$(_HarmonyDll)'。请确认 Lib.Harmony 已还原（dotnet restore）。" />

    <Copy SourceFiles="@(_Deploy)" DestinationFolder="$(_ModDir)" />
    <Copy SourceFiles="@(_DeployCsv)" DestinationFolder="$(_ModLocDir)" />
    <Copy SourceFiles="@(_DeployLib)" DestinationFolder="$(_ModLibDir)" />

    <Message Importance="high" Text="$(_EliteTag) 部署 · 已同步到 $(_ModDir) · $(_EliteBuildMark)" />
  </Target>

  <!-- GenerateWorkshopBbcode: 生成工坊页 BBCode。
       挂在构建上避免 md 更新后 bbcode 静默过期（artifacts\ 在 .gitignore 中）。
       -p:WorkshopBbcode=false 关闭；ContinueOnError 避免阻断模组构建。
       详见 docs/build-system.md §3.3 和 §4 -->
  <Target Name="GenerateWorkshopBbcode" AfterTargets="Build"
          Condition="'$(WorkshopBbcode)' != 'false'">
    <!-- StdOutEncoding/StdErrEncoding: 子进程输出 UTF-8，必须显式声明避免乱码。
         详见 docs/build-system.md §4.1 -->
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\tools\MdToBbcode&quot; --configuration Release"
          StdOutEncoding="UTF-8" StdErrEncoding="UTF-8"
          ContinueOnError="true" />
    <Exec Command="py &quot;$(MSBuildProjectDirectory)\tools\gen-affix-overview.py&quot;"
          StdOutEncoding="UTF-8" StdErrEncoding="UTF-8"
          ContinueOnError="true" />
  </Target>

</Project>
